{
  "name": "hooks-ts",
  "version": "0.12.0",
  "description": "",
  "author": "Michał Worwąg",
  "homepage": "https://hooks-ts.com",
  "keywords": [
    "hooks",
    "typescript",
    "react"
  ],
  "license": "MIT",
  "scripts": {
    "ci": "pnpm build && pnpm format && pnpm check-format && pnpm check-exports && pnpm lint",
    "build": "tsup",
    "prepublishOnly": "pnpm run ci",
    "lint": "tsc",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "test": "vitest run",
    "dev": "vitest",
    "preinstall": "npx only-allow pnpm"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "react": "^16.8.0  || ^17 || ^18 || ^19 || ^19.0.0-rc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michal-worwag/hooks-ts"
  },
  "bugs": {
    "url": "https://github.com/michal-worwag/hooks-ts/issues"
  }
}
