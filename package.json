{
  "name": "hooks-ts-monorepo",
  "private": true,
  "description": "",
  "author": "Michał Worwąg",
  "license": "MIT",
  "keywords": [
    "hooks",
    "typescript",
    "react"
  ],
  "scripts": {
    "ci": "pnpm --filter ./packages/hooks-ts run ci && pnpm --filter ./packages/hooks-ts test && pnpm --filter www typecheck && pnpm --filter www build",
    "release": "pnpm --filter ./packages/hooks-ts build && changeset publish",
    "local-release": "changeset version && pnpm release",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7"
  }
}
